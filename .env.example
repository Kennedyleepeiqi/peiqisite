# Contact form (Resend) — copy to .env.local and fill in to enable email delivery.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered
CONTACT_TO_EMAIL=you@example.com

# Verified sender (use onboarding@resend.dev for testing, or your verified domain)
CONTACT_FROM_EMAIL=Peiqi Portfolio <onboarding@resend.dev>
